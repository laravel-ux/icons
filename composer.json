{
    "name": "laravel-ux/icons",
    "description": "Icons for the Laravel UX.",
    "keywords": ["laravel", "tailwind"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "blade-ui-kit/blade-icons": "^1.10",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "LaravelUx\\Icons\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaravelUx\\Icons\\IconsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
